{
  "manifest": "CJS_ENGINE_WEBGPU_DRAW_FIXTURES",
  "manifestVersion": 1,
  "gate": "npm run test:webgpu:required -- --draw-quadv5 <dx11.cewgpu> <dx12.cewgpu>",
  "rationale": "A .cewgpu is a derived artifact, fully determined by (source bytes at a pinned build id + compiler version). Storing the package duplicates a guarantee the compiler already gives and rots silently when the compiler moves. This manifest pins the identity instead: rebuild, compare packageSha256, and a compiler change announces itself as a reviewable manifest diff. The rendered target bytes are pinned because they are the only part that needs a GPU to reproduce.",
  "sourcePolicy": "Source .sm_lo/.sm_hi/.sm_depth bytes are CCP game files. Never commit, fixture, or publish them. Fetch through tools-core at the pinned build id.",
  "goldenTargets": {
    "path": "unpacked_quadv5.sm_hi-ppt-main.golden.png",
    "capture": "--capture-quadv5 <path>",
    "targetWidth": 64,
    "targetHeight": 64,
    "renderTargets": 2,
    "device": "Chrome (channel: chrome) + Dawn/SwiftShader"
  },
